# Configurações de Produção - Hub Gerencial

# URL da API do Hub em Produção
# Se o Nginx ou Gateway fizer proxy reverso das rotas /api, use "/"
# Caso a API esteja em outro domínio/subdomínio, informe a URL completa (ex: https://api.amurahub.com.br)
VITE_HUB_API_URL=/

# Identificação da Aplicação
VITE_APP_TITLE="Hub Gerencial | Amura"
VITE_APP_VERSION="1.0.0"
VITE_APP_ENV="production"
