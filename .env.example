# ============================================================
# Hub Gestor — Template de Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores.
# O arquivo .env está no .gitignore e NUNCA deve ser commitado.
# ============================================================

# URL base da Hub API.
# - Deixe vazio ("") para usar o proxy reverso local /api (desenvolvimento)
# - Ou informe a URL completa em produção (ex: https://api.seudominio.com.br)
VITE_HUB_API_URL=

# Alvo do proxy do Vite (apenas em desenvolvimento local).
# Aponta para o endereço do backend Hub API na máquina local.
VITE_API_PROXY_TARGET=http://127.0.0.1:5279

# Identificação da aplicação (exibida no título do browser)
VITE_APP_TITLE="Hub Gestor | Sua Empresa"

# Versão da aplicação
VITE_APP_VERSION="1.0.0"

# Ambiente: "development" | "production"
VITE_APP_ENV="development"
